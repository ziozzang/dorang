# dorang — LiteLLM parity configuration (front-proxy mode)
#
# WHAT THIS IS
#   The 39-model surface of the live LiteLLM instance, reproduced on dorang,
#   with the LiteLLM instance itself as the single upstream. This is the
#   configuration the differential harness runs, and it is deliberately a
#   front proxy rather than a cutover: with one upstream behind both gateways,
#   every difference the harness reports is attributable to the gateway and
#   not to a different backend answering. `dorang-direct.yaml.tmpl` is the
#   cutover shape.
#
# WHY IT IS A TEMPLATE
#   dorang expands environment variables in secret fields ONLY (key_env /
#   key_file). `providers[].base_url` is a literal string with no expansion,
#   so the upstream host cannot be referenced by variable in the file itself.
#   Render it before use:
#
#     set -a; . ~/env; set +a
#     envsubst < dorang.yaml.tmpl > "$RUNDIR/dorang.yaml"
#
#   Only ${LITELLM_OPENAI_BASE_URL} is substituted. The API key is NOT
#   substituted: it stays a `key_env:` reference and is read from the process
#   environment at load. See REPORT.md gap G1.
#
# STATE
#   Every state path is written with a leading `~` and relocated by
#   $DORANG_STATE_DIR, so nothing here names a home directory.

version: 1

server:
  listen: ":4100"
  env: production
  master_key_env: DORANG_MASTER_KEY
  key_pepper_env: DORANG_KEY_PEPPER
  # LiteLLM's own default is 6000s (COMPATIBILITY §8); dorang's schema default
  # is 600s, so it is set explicitly rather than inherited.
  request_timeout: 6000s
  shutdown_grace: 30s

storage:
  driver: sqlite
  sqlite:
    path: ~/.dorang/dorang.db

providers:
  - name: litellm
    kind: openai
    base_url: ${LITELLM_OPENAI_BASE_URL}
    timeout: 6000s
    # LiteLLM's documented default is num_retries: 2.
    retry: {max_attempts: 2, backoff: exponential, base: 500ms}
    # The upstream is itself a gateway in front of hosted caches; nothing here
    # holds KV blocks for us, so prefix affinity buys nothing and a long TTL
    # would pin conversations for no reason.
    prefix_ttl: 5m

credentials:
  - id: litellm-1
    provider: litellm
    key_env: LITELLM_OPENAI_API_KEY

# ---------------------------------------------------------------------------
# The 39 ids, forwarded verbatim.
#
# `upstream_model` is byte-identical to `name` for every entry, including the
# three LiteLLM-side aliases (local, public, public-free) and the two prefixed
# namespaces (nim:, zai:). A model name is opaque to dorang: nothing splits it
# on ':' or '.', so `zai:glm-5-turbo` and `mistral-large-3:675b` are names, not
# structures (CONFIG §10.1).
#
# The three aliases are declared as MODELS here, not under `aliases:`, because
# resolving them dorang-side needs to know their targets and the LiteLLM key
# available is not permitted GET /model/info (403). See REPORT.md gap G2.
# ---------------------------------------------------------------------------
