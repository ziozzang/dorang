# Build output.
#
# These MUST stay anchored. Unanchored `dorang` matches the *directory*
# cmd/dorang/ as well as the binary, which silently untracked the entire cmd/
# tree — the gateway's own entry point was never in version control and a fresh
# clone did not build, while `git status` reported clean.
/bin/
/dist/
/dorang
/dorangctl
*.test
*.out
coverage.*

# Local dev
.env
*.local.yaml
/data/
/tmp/

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Agent scratch
.claude/
.jikji/

# Local-only working notes (deployment specifics, not for publication)
docs/internal/
